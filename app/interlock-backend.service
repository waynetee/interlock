# The GPU backend: generation, and the prover the challenge runs against.
#
# WHY THIS IS NOT IN THE ilk_server CONTAINER. It needs CUDA, so it runs on the
# host and the container talks to it over 127.0.0.1:9917. That split is easy to
# misread: `docker ps` showing ilk_server healthy says nothing about whether this
# is up, and ilk_server itself logs only a warning and keeps serving. The failure
# then surfaces at challenge time, which is the worst place to find it.
#
# The environment below mirrors bringup.sh's launch block. Keep the two in step.
[Unit]
Description=Interlock model backend (generation + prover, GPU)
Documentation=https://github.com/waynetee/interlock
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spark
Group=spark
WorkingDirectory=/home/spark/v2/interlock/app
Environment=PATH=/home/spark/v2/VerInf/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=VERINF=/home/spark/v2/VerInf
Environment=MODEL_DIR=/home/spark/v2/VerInf/models/TinyLlama-1.1B-Chat-v1.0
# Load the weights at start rather than on the first request: without this the
# first proof of the day pays a ~30 s model load with an audience watching.
Environment=PRELOAD_MODEL=1
Environment=DEMO_SELF_POLICY=1
Environment=ENROLL_DIR=/home/spark/v2/VerInf/.enroll
Environment=ENROLL_LEDGER=0
ExecStart=/home/spark/v2/VerInf/venv/bin/python -u model_backend.py

# Weights onto the GPU take ~30 s cold, and longer on a cold page cache after a
# reboot -- which is exactly when this unit runs.
TimeoutStartSec=300
Restart=always
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=interlock-backend

[Install]
WantedBy=multi-user.target
