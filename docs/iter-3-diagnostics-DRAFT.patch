From: iter-3 diagnostics (DRAFT — apply with `git apply` if sub-PR #9 doesn't fully fix PHY 19)
Subject: Add MDIO indicator-bit capture + full PCS register dump

These additions are purely diagnostic and purely additive.  They don't
touch any existing code path, so applying or reverting is safe.

What they buy us:

1. `mdio_read_v` — like `mdio_read`, but captures the BUSY/SCANNING/
   NOT_VALID bits of the MDIO Mgmt: Indicators register (CSR 0x034)
   on master-side timeout, and adds a timeout so a broken slave can't
   hang firmware forever.  The existing `mdio_read` blocks indefinitely
   if the indicators never clear — risky during bring-up.

2. `dump_pcs` — reads four diagnostic registers (Control 0x00, Status
   0x01, Extended Status 0x0F, TBI Control 0x11) from a single MDIO
   address, prints each with its indicator byte and cycle count.

3. One call from `main` after init, before the polling loop, dumping
   PHY 18 (CORETSE_0, known good), PHY 19 (CORETSE_1, under test),
   and PHY 17 (unused — negative control to verify our notion of a
   "fully silent" response).

What the indicator bits tell us:
- `i=00` after timeout=0 cycles: clean read.  Whatever data was returned
  was driven onto the bus (even 0xFFFF would then mean "slave responded
  with all 1s", which would be unexpected but observable).
- `i=04` (NOT_VALID set): master timed out internally.  No clean
  response from the bus.
- `i=01` (BUSY persistent): master still trying.  Our loop timed out
  externally before the master finished — implies bus stuck or master
  internally hung.
- Cycle count (c=) shows how long the loop took.  Clean reads should
  complete in a few hundred PCLK cycles.  A read that hits our timeout
  means master never finished.

Apply with:

    cd /root/fpga/interlock
    git apply docs/iter-3-diagnostics-DRAFT.patch
    # then commit and rebuild bitstream

---

diff --git a/gateware/src/src_softconsole/main.c b/gateware/src/src_softconsole/main.c
--- a/gateware/src/src_softconsole/main.c
+++ b/gateware/src/src_softconsole/main.c
@@ -117,6 +117,72 @@ static uint16_t mdio_read(uint32_t tse_base, uint8_t phy, uint8_t reg)
     return v;
 }

+/* Verbose MDIO read with timeout + indicator capture.
+ *
+ * Unlike mdio_read, this:
+ *   - Bounds the wait with a cycle counter so a broken slave can't hang
+ *     firmware forever (existing mdio_read uses an unbounded while loop).
+ *   - Captures the indicator bits (BUSY/SCANNING/NOT_VALID at CSR 0x034)
+ *     when the loop exits — either because the transaction completed
+ *     (indicators all clear, ind_out=0) or because we timed out (ind_out
+ *     contains whichever bits were still asserted).
+ *
+ * Used by dump_pcs() for diagnostic register reads where we want to
+ * distinguish "slave never responded → bus pulled high → data=0xFFFF
+ * with ind=00" from "master timed out internally → data=0xFFFF with
+ * ind=04 (NOT_VALID)".
+ */
+static uint16_t mdio_read_v(uint32_t tse_base, uint8_t phy, uint8_t reg,
+                             uint32_t *ind_out, uint32_t *cycles_out)
+{
+    *(volatile unsigned int *)(tse_base + 0x028) = mdio_addr(phy, reg);
+    *(volatile unsigned int *)(tse_base + 0x024) = 0x1;
+
+    uint32_t cycles = 0;
+    uint32_t ind;
+    do {
+        ind = *(volatile unsigned int *)(tse_base + 0x034) & 0x7;
+        if (ind == 0) break;
+        cycles++;
+    } while (cycles < 100000);
+
+    *ind_out = ind;
+    *cycles_out = cycles;
+
+    uint16_t v = (uint16_t) *(volatile unsigned int *)(tse_base + 0x030);
+    *(volatile unsigned int *)(tse_base + 0x024) = 0x0;
+    return v;
+}
+
+/* Full PCS register dump for a single MDIO address.
+ *
+ * Reads the four most-diagnostic SGMII/TBI registers from §3.5 of the
+ * CoreTSE doc and prints each with its indicator bits and cycle count.
+ * Helps distinguish multiple failure modes for a non-responding slave.
+ */
+static void dump_pcs(const char *label, uint8_t phy)
+{
+    uint32_t ind, cyc;
+    uint16_t r;
+
+    uart_print("[pcs] ");
+    uart_print(label);
+    uart_print(" addr=");
+    uart_print_dec(phy);
+
+    r = mdio_read_v(TSE_BASEADDR, phy, 0x00, &ind, &cyc);
+    uart_print(" Ctl=");    uart_print_hex16(r);
+    uart_print("/i=");      uart_print_hex16((uint16_t)ind);
+    uart_print("/c=");      uart_print_hex16((uint16_t)cyc);
+
+    r = mdio_read_v(TSE_BASEADDR, phy, 0x01, &ind, &cyc);
+    uart_print(" Sts=");    uart_print_hex16(r);
+    uart_print("/i=");      uart_print_hex16((uint16_t)ind);
+
+    r = mdio_read_v(TSE_BASEADDR, phy, 0x0F, &ind, &cyc);
+    uart_print(" ExtSts="); uart_print_hex16(r);
+    uart_print("/i=");      uart_print_hex16((uint16_t)ind);
+
+    r = mdio_read_v(TSE_BASEADDR, phy, 0x11, &ind, &cyc);
+    uart_print(" TBICtl="); uart_print_hex16(r);
+    uart_print("/i=");      uart_print_hex16((uint16_t)ind);
+
+    uart_print("\r\n");
+}
+
 static void mdio_write(uint32_t tse_base, uint8_t phy, uint8_t reg, uint16_t val)
 {
     *(volatile unsigned int *)(tse_base + 0x028) = mdio_addr(phy, reg);
@@ -758,6 +824,12 @@ int main(void)
     uart_print_hex32(tse1_mc1);
     uart_print("\r\n");

+    /* iter-3 diagnostic: full PCS register dump for both CoreTSEs +
+     * an unused-address negative control to verify "fully silent" baseline. */
+    uart_print("[diag] PCS register dump (iter-3 verbose probes)\r\n");
+    dump_pcs("PHY18 (CORETSE_0 known good)", 18);
+    dump_pcs("PHY19 (CORETSE_1 under test)", 19);
+    dump_pcs("PHY17 (unused; negative ctl)", 17);
+
     uart_print("[boot] init complete — polling both ports\r\n");

     uint32_t tick = 0;
